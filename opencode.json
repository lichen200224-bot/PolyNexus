{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",

    "skill": {
      "*": "ask",
      "polynexus-*": "allow"
    },

    "edit": "ask",

    "bash": {
      "*": "ask",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",

      "git add*": "deny",
      "git commit*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git restore*": "deny",
      "git clean*": "deny",
      "git push*": "deny",

      "rm *": "deny",
      "Remove-Item *": "deny"
    },

    "external_directory": "deny",
    "task": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "todowrite": "allow",
    "question": "allow",
    "doom_loop": "ask"
  }
}
