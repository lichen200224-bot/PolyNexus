{
  "version": "1.1.0",
  "states": [
    "TASK_CREATED",
    "WRITER_IN_PROGRESS",
    "READY_FOR_CODEX_ACCEPTANCE",
    "CODEX_ACCEPTANCE_IN_PROGRESS",
    "CODEX_REJECTED",
    "FIX_REQUIRED",
    "READY_FOR_REVERIFICATION",
    "CODEX_REVERIFICATION_IN_PROGRESS",
    "CODEX_ACCEPTED",
    "ANTIGRAVITY_VERIFICATION_REQUIRED",
    "ANTIGRAVITY_VERIFICATION_IN_PROGRESS",
    "ANTIGRAVITY_REJECTED",
    "FINAL_ACCEPTANCE_IN_PROGRESS",
    "HUMAN_APPROVAL_REQUIRED",
    "COMMIT_APPROVED",
    "COMMITTED",
    "TASK_CLOSED",
    "NEED_ACTION",
    "BLOCKED"
  ],
  "transitions": [
    { "from": "TASK_CREATED", "to": "WRITER_IN_PROGRESS", "guard": "Task has id, goal, scope, non-goals, and acceptance criteria" },
    { "from": "WRITER_IN_PROGRESS", "to": "READY_FOR_CODEX_ACCEPTANCE", "guard": "Writer handoff, tests, evidence, and Codex prompt exist" },
    { "from": "READY_FOR_CODEX_ACCEPTANCE", "to": "CODEX_ACCEPTANCE_IN_PROGRESS", "guard": "Independent reviewer receives the complete prompt" },
    { "from": "CODEX_ACCEPTANCE_IN_PROGRESS", "to": "CODEX_ACCEPTED", "guard": "Every required criterion has evidence-backed PASS" },
    { "from": "CODEX_ACCEPTANCE_IN_PROGRESS", "to": "CODEX_REJECTED", "guard": "At least one blocking issue has a complete FIX PROMPT", "required_fields": ["issues", "next_prompt"] },
    { "from": "CODEX_REJECTED", "to": "FIX_REQUIRED", "guard": "Target tool and allowed scope are explicit" },
    { "from": "FIX_REQUIRED", "to": "READY_FOR_REVERIFICATION", "guard": "Fix result and Codex reverification prompt exist", "required_fields": ["modified_files", "evidence", "next_prompt"] },
    { "from": "READY_FOR_REVERIFICATION", "to": "CODEX_REVERIFICATION_IN_PROGRESS", "guard": "Codex receives original criteria and fix evidence" },
    { "from": "CODEX_ACCEPTED", "to": "ANTIGRAVITY_VERIFICATION_REQUIRED", "guard": "Codex identifies a UI, interaction, visual, or integration risk" },
    { "from": "CODEX_ACCEPTED", "to": "FINAL_ACCEPTANCE_IN_PROGRESS", "guard": "No Antigravity gate is required" },
    { "from": "ANTIGRAVITY_VERIFICATION_REQUIRED", "to": "ANTIGRAVITY_VERIFICATION_IN_PROGRESS", "guard": "Verification scope and evidence requirements are explicit" },
    { "from": "ANTIGRAVITY_VERIFICATION_IN_PROGRESS", "to": "ANTIGRAVITY_ACCEPTED", "guard": "Every specified verification item has evidence-backed PASS" },
    { "from": "ANTIGRAVITY_VERIFICATION_IN_PROGRESS", "to": "ANTIGRAVITY_REJECTED", "guard": "A verification issue has a complete FIX PROMPT" },
    { "from": "ANTIGRAVITY_ACCEPTED", "to": "FINAL_ACCEPTANCE_IN_PROGRESS", "guard": "Codex receives Antigravity evidence" },
    { "from": "FINAL_ACCEPTANCE_IN_PROGRESS", "to": "HUMAN_APPROVAL_REQUIRED", "guard": "All required gates pass and protected-area check has evidence" },
    { "from": "HUMAN_APPROVAL_REQUIRED", "to": "COMMIT_APPROVED", "guard": "Human explicitly writes APPROVED_FOR_COMMIT with task id and scope" },
    { "from": "COMMIT_APPROVED", "to": "COMMITTED", "guard": "Only approved scope is committed" },
    { "from": "COMMITTED", "to": "TASK_CLOSED", "guard": "Commit id and final audit trail are recorded" }
  ],
  "terminal_states": ["TASK_CLOSED", "BLOCKED"]
}
